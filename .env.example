# ══════════════════════════════════════════════════════════════════════
# Crown Coffee Admin — Environment Variables
# ══════════════════════════════════════════════════════════════════════
#
# LOCAL DEVELOPMENT:
#   Copy this file to .env.local and fill in all values
#
# NETLIFY DEPLOYMENT:
#   Go to: Netlify → Site Configuration → Environment Variables
#   Add EVERY variable below (skip the comments/blank lines)
#   Then trigger a new deploy.
#
# ══════════════════════════════════════════════════════════════════════


# ─── Supabase (REQUIRED — app will not work without these) ───────────
# Get from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key


# ─── Site URL (REQUIRED — used in email links) ────────────────────────
# Set to your live domain on Netlify (no trailing slash)
NEXT_PUBLIC_APP_URL=https://ccadmin.online
NEXT_PUBLIC_SITE_URL=https://ccadmin.online


# ─── AI Services ─────────────────────────────────────────────────────
# Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# Anthropic Claude (document scanning / AI analysis fallback)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key


# ─── Email — Gmail SMTP (REQUIRED for all email notifications) ────────
# Use a Gmail App Password (not your regular password)
# How to create: Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# SMTP config (same Gmail account — used by staff query emails)
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
ADMIN_EMAIL=your_admin_email@gmail.com


# ─── Twilio SMS (optional — SMS notifications for members) ───────────
# https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx


# ─── WhatsApp Business API (optional) ────────────────────────────────
# https://developers.facebook.com/apps/
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_access_token


# ─── Menu Costing Module ─────────────────────────────────────────────
# Used for bootstrapping the first admin user via /api/costing/auth/setup
# Set a strong random string (e.g. openssl rand -hex 32)
COSTING_SETUP_KEY=your_strong_random_key_here
