# ─── Supabase ───────────────────────────────────────────────
# Get from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ─── Anthropic AI (Document Scanning) ──────────────────────
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key

# ─── Menu Costing Module ─────────────────────────────────────
# Used for bootstrapping the first admin user via /api/costing/auth/setup
# Set a strong random string (e.g. openssl rand -hex 32)
COSTING_SETUP_KEY=your_very_strong_random_setup_key
